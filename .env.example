# Copy to .env. The Makefile loads it; .env itself is never committed.
#
# Config is parsed once into a typed struct at boot and the process refuses to
# start if anything here is missing or wrong (technical.md §13).

# development | production — decides the log format.
ETM_ENV=development

# Address the HTTP server binds.
ETM_ADDR=:8080

# Matches the credentials in compose.yaml.
ETM_DATABASE_URL=postgres://etm:etm@localhost:5432/etm?sslmode=disable

# The origin a browser reaches this server on, without a trailing slash.
#
# The OAuth redirect URI is built from it — a Host header is attacker-controlled
# and would make that a moving target — and its scheme decides whether the
# session cookie carries Secure. Production must be https, and the process
# refuses to start otherwise.
ETM_PUBLIC_URL=http://localhost:8080

# Google OAuth client (technical.md §9). Required, and there is nothing to fall
# back to: an account is the price of entry, so a server that cannot sign anyone
# in has nothing to serve and says so at boot rather than at the first player.
#
# Create one at https://console.cloud.google.com/apis/credentials —
# "Create credentials" → "OAuth client ID" → "Web application" — and register
# this exact redirect URI:
#
#   http://localhost:8080/api/auth/google/callback
ETM_GOOGLE_CLIENT_ID=
ETM_GOOGLE_CLIENT_SECRET=
